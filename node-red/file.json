  {
    "id": "ifaci_function_payload",
    "type": "function",
    "z": "ifaci_tab_main",
    "name": "Montar payload do backend",
    "func": "const raw = msg.payload;\nlet value = raw;\n\nif (raw && typeof raw === \"object\") {\n    if (raw.value !== undefined) {\n        value = raw.value;\n        if (value && typeof value === \"object\" && value.value !== undefined) {\n            value = value.value;\n        }\n    } else if (raw.payload !== undefined) {\n        value = raw.payload;\n    }\n}\n\nif (value === undefined || value === null || (typeof value === \"number\" && Number.isNaN(value))) {\n    node.warn(`Leitura invalida para ${msg.sensorTag || msg.topic}`);\n    return null;\n}\n\nif (typeof value === \"number\") {\n    value = Number(value.toFixed(2));\n}\n\nmsg.url = env.get(\"IFACI_BACKEND_URL\") || \"http://127.0.0.1:8080/iot\";\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    deviceId: \"opcua-lab-01\",\n    name: \"Bancada OPC UA\",\n    type: \"CLP / Sensores\",\n    location: \"Laboratorio IFAC\",\n    tag: msg.sensorTag,\n    valor: value,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 940,
    "y": 240,
    "wires": [
      [
        "ifaci_http_backend",
        "ifaci_debug_payload"
      ]
    ]
  },
